# CodeIgniter 4
.env
vendor/
writable/cache/*
writable/debugbar/*
writable/logs/*
writable/session/*
writable/uploads/*
!writable/*/.gitkeep
!writable/*/*/.gitkeep
phpunit.xml.dist
.phpunit.result.cache

# OS
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE
.idea/
.vscode/
.vs/
*.suo
*.user
composer.phar

# appfiles : contenu genere/utilisateurs — structure conservee via .gitkeep
appfiles/upload/*
appfiles/uploads/*
appfiles/userfiles/*
!appfiles/upload/gpx/
!appfiles/upload/reponse/
!appfiles/uploads/pdf_tickets/
!appfiles/uploads/tickets/
appfiles/upload/gpx/*
appfiles/upload/reponse/*
appfiles/uploads/pdf_tickets/*
appfiles/uploads/tickets/*
!.gitkeep
*.zip
