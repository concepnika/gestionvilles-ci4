# CodeIgniter 4
.env
vendor/
writable/cache/*
writable/debugbar/*
writable/logs/*
writable/session/*
writable/uploads/*
!writable/*/.gitkeep
!writable/*/*/.gitkeep
phpunit.xml.dist
.phpunit.result.cache

# OS
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE
.idea/
.vscode/
.vs/
*.suo
*.user
composer.phar

# ci3files : contenu genere/utilisateurs — structure conservee via .gitkeep
ci3files/upload/*
ci3files/uploads/*
ci3files/userfiles/*
!ci3files/upload/gpx/
!ci3files/upload/reponse/
!ci3files/uploads/pdf_tickets/
!ci3files/uploads/tickets/
ci3files/upload/gpx/*
ci3files/upload/reponse/*
ci3files/uploads/pdf_tickets/*
ci3files/uploads/tickets/*
!.gitkeep
